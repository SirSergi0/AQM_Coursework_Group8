\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Quantum circuit implementing the Quantum Fourier Transform (QFT). The output states are shown unnormalized (the $1/\sqrt  {2}$ factors are omitted). Controlled phase shift gates $CR_k$ are represented by phase shift gates $R_k$ acting on the target qubit, with filled dots indicating their respective control qubits. Notice how by reading the output qubits downwards, we obtain the QFT in the reversed order (see Eq. \eqref  {eq: QFT output}), so a final SWAP gate is required in order to obtain the desired result.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:qft}{{1}{3}{Quantum circuit implementing the Quantum Fourier Transform (QFT). The output states are shown unnormalized (the $1/\sqrt {2}$ factors are omitted). Controlled phase shift gates $CR_k$ are represented by phase shift gates $R_k$ acting on the target qubit, with filled dots indicating their respective control qubits. Notice how by reading the output qubits downwards, we obtain the QFT in the reversed order (see Eq. \eqref {eq: QFT output}), so a final SWAP gate is required in order to obtain the desired result}{figure.1}{}}
